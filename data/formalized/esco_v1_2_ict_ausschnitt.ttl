@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix hrqde: <https://hrqde.example.org/ontology#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix harm: <http://hr-qde.org/harmonised/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

harm:CompetenceConcept a owl:NamedIndividual ;
    skos:prefLabel "Competence concept — enters pipeline"@en .

harm:LevelConcept a owl:NamedIndividual ;
    skos:prefLabel "Level concept — skeleton import only"@en .



<http://data.europa.eu/esco/occupation/0464b062-cea6-4164-b10d-956c61956ae7> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT security administrators plan and carry out security measures to protect information and data from unauthorised access, deliberate attack, theft and corruption."@en ;

    skos:prefLabel "IT-Sicherheitsadministrator/IT-Sicherheitsadministratorin"@de,

        "ICT security administrator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "0464b062-cea6-4164-b10d-956c61956ae7" .



<http://data.europa.eu/esco/occupation/04ba4d6c-957d-417f-bf63-5b9e015a9f86> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Software analysts elicit and prioritise user requirements, produce and document software specifications, test their application, and review them during software development. They act as the interface between the software users and the software development team."@en ;

    skos:prefLabel "Softwareanalytiker/Softwareanalytikerin"@de,

        "software analyst"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "04ba4d6c-957d-417f-bf63-5b9e015a9f86" .



<http://data.europa.eu/esco/occupation/07e60525-1aad-4099-aaf3-2c7014c92212> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Integration engineers develop and implement solutions which coordinate applications across the enterprise or its units and departments. They evaluate existing components or systems to determine integration requirements and ensure that the final solutions meet organisational needs. They reuse components when possible and assist management in taking decisions. They perform ICT system integration troubleshooting."@en ;

    skos:prefLabel "Fachinformatiker der Fachrichtung Systemintegration/Fachinformatikerin der Fachrichtung Systemintegration"@de,

        "integration engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "07e60525-1aad-4099-aaf3-2c7014c92212" .



<http://data.europa.eu/esco/occupation/092fdeeb-a76f-4ed2-b248-90fd6eaaffef> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Search engine optimisation experts increase the ranking of a company's web pages with regard to target queries in a search engine. They create and launch SEO campaigns and identify areas of improvement. Search engine optimisation experts may conduct pay per click (PPC) campaigns."@en ;

    skos:prefLabel "Experte für Suchmaschinenoptimierung/Expertin für Suchmaschinenoptimierung"@de,

        "search engine optimisation expert"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "092fdeeb-a76f-4ed2-b248-90fd6eaaffef" .



<http://data.europa.eu/esco/occupation/0ab5c12c-c1c1-4772-8345-aa287d0e391d> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT test analysts work in testing environments, assessing products, checking for quality and accuracy, or creating tests scripts. They design tests which are then implemented by testers."@en ;

    skos:prefLabel "IT-Testanalytiker/IT-Testanalytikerin"@de,

        "ICT test analyst"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "0ab5c12c-c1c1-4772-8345-aa287d0e391d" .



<http://data.europa.eu/esco/occupation/0c448a27-10ec-43ba-b880-d9938bade424> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Digital forensics experts retrieve and analyse information from computers and other types of data storage devices. They examine digital media that may have been hidden, encrypted or damaged, in a forensic manner with the aim to identify, preserve, recover, analyse and present facts and opinions about the digital information."@en ;

    skos:prefLabel "IT-Forensik-Experte/IT-Forensik-Expertin"@de,

        "digital forensics expert"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "0c448a27-10ec-43ba-b880-d9938bade424" .



<http://data.europa.eu/esco/occupation/0ce5a9f4-e00a-4bbe-b255-3c63407167a4> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cyber incident responders monitor and assess cybersecurity state systems, analysing, evaluating, and mitigating the impact of cybersecurity incidents. Moreover, they identify malicious actors and cyber incidents root causes. According to the organisation’s Incident Response Plan, they restore systems and process functionalities to an operational state, collecting evidence and documenting actions taken."@en ;

    skos:prefLabel "Verantwortlicher für die Reaktion auf Cybervorfälle/Verantwortliche für die Reaktion auf Cybervorfälle"@de,

        "cyber incident responder"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "0ce5a9f4-e00a-4bbe-b255-3c63407167a4" .



<http://data.europa.eu/esco/occupation/102e75c8-3b47-4964-9b47-30a980aed25c> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT disaster recovery analysts develop, maintain, and implement ICT continuity and disaster recovery strategies and solutions. They support the technical teams, assess the risks, design and develop procedures, documentation and strategies for disaster recovery in order for business functions to continue and recover with a minimal loss of data. They also coordinate the system backups tests and validations."@en ;

    skos:prefLabel "Analytiker für IT-Notfallwiederherstellung/Analytikerin für IT-Notfallwiederherstellung"@de,

        "ICT disaster recovery analyst"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "102e75c8-3b47-4964-9b47-30a980aed25c" .



<http://data.europa.eu/esco/occupation/10469d70-78a3-4650-9e29-d04de13c62c1> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Embedded system designers translate and design requirements and the high-level plan or architecture of an embedded control system according to technical software specifications."@en ;

    skos:prefLabel "Embedded System Designer/Embedded System Designerin"@de,

        "embedded system designer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "10469d70-78a3-4650-9e29-d04de13c62c1" .



<http://data.europa.eu/esco/occupation/106f79e4-6264-45f1-9e7a-297435cd684b> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Software testers perform software tests. They may also plan and design them. They may also debug and repair software although this mainly corresponds to designers and developers. They ensure that applications function properly before delivering them to internal and external clients."@en ;

    skos:prefLabel "Softwareprüfer/Softwareprüferin"@de,

        "software tester"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "106f79e4-6264-45f1-9e7a-297435cd684b" .



<http://data.europa.eu/esco/occupation/1562c7a3-c7d9-419d-b9b6-db26610bcf84> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Data warehouse designers are responsible for planning, connecting, designing, scheduling, and deploying data warehouse systems. They develop, monitor and maintain ETL processes, reporting applications and data warehouse design."@en ;

    skos:prefLabel "Data-Warehouse-Entwickler/Data-Warehouse-Entwicklerin"@de,

        "data warehouse designer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "1562c7a3-c7d9-419d-b9b6-db26610bcf84" .



<http://data.europa.eu/esco/occupation/1c5a45b9-440e-4726-b565-16a952abd341> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Computer vision engineers research, design, develop, and train artificial intelligence algorithms and machine learning primitives that understand the content of digital images based on a large amount of data. They apply this understanding to solve different real-world problems such as security, autonomous driving, robotic manufacturing, digital image classification, medical image processing and diagnosis, etc."@en ;

    skos:prefLabel "Computer-Vision-Ingenieur/Computer-Vision-Ingenieurin"@de,

        "computer vision engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "1c5a45b9-440e-4726-b565-16a952abd341" .



<http://data.europa.eu/esco/occupation/1c5a896a-e010-4217-a29a-c44db26e25da> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Embedded systems security engineers advise and implement solutions to control access to data and programs in embedded and connected systems. They help ensuring the safe operation of products with embedded systems and connected devices by being responsible for the protection and security of the related systems and design, plan and execute security measures accordingly. Embedded systems security engineers help to keep attackers at bay by implementing safeguards that prevent intrusions and breaches."@en ;

    skos:prefLabel "Sicherheitsingenieur für Embedded Systems/Sicherheitsingenieurin für Embedded Systems"@de,

        "embedded systems security engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "1c5a896a-e010-4217-a29a-c44db26e25da" .



<http://data.europa.eu/esco/occupation/2079755f-d809-49e6-8037-4de6180e54c0> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Data engineers develop the architecture needed to process, manage, and store large amounts of data which will be used by data scientists for analysis. They design the infrastructure and maintain data pipelines and warehouses to leverage data for strategic advantage."@en ;

    skos:prefLabel "Dateningenieur/Dateningenieurin"@de,

        "data engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "2079755f-d809-49e6-8037-4de6180e54c0" .



<http://data.europa.eu/esco/occupation/22987b58-dbfa-4ecd-ae3f-82dd209255f6> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Green ICT consultants advise organisations on their green ICT strategy and its implementation in the most effective and efficient manner to allow the organisation to reach their short, mid, and long term ICT environmental objectives."@en ;

    skos:prefLabel "Green-IT-Berater/Green-IT-Beraterin"@de,

        "green ICT consultant"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "22987b58-dbfa-4ecd-ae3f-82dd209255f6" .



<http://data.europa.eu/esco/occupation/24135b84-cbdd-4d42-9ed2-02fd982d15b2> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Blockchain developers implement or program blockchain-based software systems based on specifications and designs by using programming languages, tools, and blockchain platforms."@en ;

    skos:prefLabel "Blockchain-Entwickler/Blockchain-Entwicklerin"@de,

        "blockchain developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "24135b84-cbdd-4d42-9ed2-02fd982d15b2" .



<http://data.europa.eu/esco/occupation/258e46f9-0075-4a2e-adae-1ff0477e0f30> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Data scientists find and interpret rich data sources, manage large amounts of data, merge data sources, ensure consistency of data-sets, and create visualisations to aid in understanding data. They build mathematical models using data, present and communicate data insights and findings to specialists and scientists in their team and if required, to a non-expert audience, and recommend ways to apply the data."@en ;

    skos:prefLabel "Datenwissenschaftler/Datenwissenschaftlerin"@de,

        "data scientist"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "258e46f9-0075-4a2e-adae-1ff0477e0f30" .



<http://data.europa.eu/esco/occupation/276ba420-ef09-4a0e-b215-2c2e2f80ad28> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Chief ICT security officers protect company and employee information against unauthorized access. They also define the Information System security policy, manage security deployment across all Information Systems and ensure the provision of information availability."@en ;

    skos:prefLabel "IT-Sicherheitsleiter/IT-Sicherheitsleiterin"@de,

        "chief ICT security officer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "276ba420-ef09-4a0e-b215-2c2e2f80ad28" .



<http://data.europa.eu/esco/occupation/2bef94db-0088-4507-982a-2ca717529adb> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Enterprise architects balance technological opportunities with business requirements. They also maintain a holistic view of the organisation's strategy, processes, information and ICT assets and link the business mission, strategy and processes to the ICT strategy."@en ;

    skos:prefLabel "Enterprise Architecture Manager/Enterprise Architecture Managerin"@de,

        "enterprise architect"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "2bef94db-0088-4507-982a-2ca717529adb" .



<http://data.europa.eu/esco/occupation/2ed56c3f-61d6-4f7e-9ef8-8849eb102e4c> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Mobile application developers implement applications software for mobile devices, based on the designs provided, using general or specific development tools for device operating systems."@en ;

    skos:prefLabel "App-Entwickler/App-Entwicklerin"@de,

        "mobile application developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "2ed56c3f-61d6-4f7e-9ef8-8849eb102e4c" .



<http://data.europa.eu/esco/occupation/2fb96c6c-8d0b-4ef0-b1ee-3e493305e4eb> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cloud architects are responsible for converting the technical features of a project into the architecture to lead to the final product. To develop technical cloud strategy, they have in-depth knowledge of the architectural principles and services, assisting with cloud migration efforts, review workload architectures, and provide guidance on how to address high-risk issues. They typically perform in a pre-sales capacity and are often asked to deliver proof-of-concept projects, topical workshops, and lead implementation projects. They team up with DevOps engineers to build the appropriate technologies."@en ;

    skos:prefLabel "Cloud-Architekt/Cloud-Architektin"@de,

        "cloud architect"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "2fb96c6c-8d0b-4ef0-b1ee-3e493305e4eb" .



<http://data.europa.eu/esco/occupation/33e4f026-a823-4ffc-99e4-60d3fe597a1e> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Digital games testers review and test various genres of digital games by playing them in order to find bugs and glitches within the game's functionality or graphics. They may evaluate the capacity of attraction and playability of games. They may also debug the games themselves."@en ;

    skos:prefLabel "Spieletester/Spieletesterin"@de,

        "digital games tester"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "33e4f026-a823-4ffc-99e4-60d3fe597a1e" .



<http://data.europa.eu/esco/occupation/349ee6f6-c295-4c38-9b98-48765b55280e> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cloud engineers are responsible for the design, planning, management and maintenance of cloud-based systems. They develop and implement cloud-applications, handle the migration of existing on-premise applications to the cloud, and debug cloud stacks."@en ;

    skos:prefLabel "Cloud-Ingenieur/Cloud-Ingenieurin"@de,

        "cloud engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "349ee6f6-c295-4c38-9b98-48765b55280e" .



<http://data.europa.eu/esco/occupation/35553663-deab-4d9a-bf22-15c1625d28e8> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Artificial intelligence engineer apply methods of artificial intelligence in engineering, robotics and computer science to design programs which simulate intelligence including thinking models, cognitive and knowledge-based systems, problem solving, and decision making. They also integrate structured knowledge into computer systems (ontologies, knowledge bases) in order to solve complex problems normally requiring a high level of human expertise or artificial intelligence methods."@en ;

    skos:prefLabel "Ingenieur für künstliche Intelligenz/Ingenieurin für künstliche Intelligenz"@de,

        "artificial intelligence engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "35553663-deab-4d9a-bf22-15c1625d28e8" .



<http://data.europa.eu/esco/occupation/3b1ea27c-781c-41eb-821f-214285260dd2> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT change and configuration managers organise and implement a process to manage changes throughout the lifecycle of ICT assets such as software, applications, ICT systems, etc. ICT change and configuration managers have a sound knowledge of the main technologies and processes used in system engineering and to manage the lifecycle of ICT systems and subsystems."@en ;

    skos:prefLabel "Manager für IKT-Wandel und -Konfiguration/Managerin für IKT-Wandel und -Konfiguration"@de,

        "ICT change and configuration manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "3b1ea27c-781c-41eb-821f-214285260dd2" .



<http://data.europa.eu/esco/occupation/3d190639-90f8-4402-b1b3-a104a17e0d67> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Database integrators perform integration among different databases. They maintain integration and ensure interoperability."@en ;

    skos:prefLabel "Experte für Datenintegration/Expertin für Datenintegration"@de,

        "database integrator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "3d190639-90f8-4402-b1b3-a104a17e0d67" .



<http://data.europa.eu/esco/occupation/4543bf7b-8ffb-4ade-88b9-58da34366f04> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT capacity planners ensure that the capacity of ICT services and ICT infrastructure is able to deliver agreed service level targets in a cost effective and timely manner. They also consider all resources required to deliver the appropriate ICT service, and plan for short, medium, and long term business requirements."@en ;

    skos:prefLabel "IT-Kapazitätsplaner/IT-Kapazitätsplanerin"@de,

        "ICT capacity planner"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "4543bf7b-8ffb-4ade-88b9-58da34366f04" .



<http://data.europa.eu/esco/occupation/456ed487-02f2-45c9-9213-d0fd8e9a069d> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT application configurators identify, record, and maintain user-specific application configurations based upon user requirements and business rules. They configure generic software systems in order to create a specific version applied to an organisation's context. These configurations range from adjusting basic parameters through the creation of business rules and roles in the ICT system to developing specific modules (including the configuration of Commercial off-the-shelf systems (COTS). They also document configurations, perform configuration updates, and ensure the configurations are correctly implemented in the application."@en ;

    skos:prefLabel "IT-Anwendungskonfigurator/IT-Anwendungskonfiguratorin"@de,

        "ICT application configurator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "456ed487-02f2-45c9-9213-d0fd8e9a069d" .



<http://data.europa.eu/esco/occupation/4b3201cb-ffc5-4f61-9fc3-5c0f0038fa5f> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT business analysis managers identify areas where information system changes are needed to support business plans and monitor the impact in terms of change management. They contribute to the general ICT functional requirements of the business organisation. ICT business analysis managers analyse business needs and translate them into ICT solutions."@en ;

    skos:prefLabel "Leiter Businessanalyse (IKT)/Leiterin Businessanalyse (IKT)"@de,

        "ICT business analysis manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "4b3201cb-ffc5-4f61-9fc3-5c0f0038fa5f" .



<http://data.europa.eu/esco/occupation/50af07f0-7a75-424e-a66d-5a9deea10f4c> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT accessibility testers evaluate websites, software applications, systems or user interface components with regards to friendliness, operability of the navigation and visibility to all types of users, especially including those with special needs or disabilities."@en ;

    skos:prefLabel "IT-Accessibility-Prüfer/IT-Accessibility-Prüferin"@de,

        "ICT accessibility tester"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "50af07f0-7a75-424e-a66d-5a9deea10f4c" .



<http://data.europa.eu/esco/occupation/52d5edc9-7902-4cd3-8b06-6bd77c98d440> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT system testers perform testing activities and some test planning activities. They may also debug and repair ICT systems and components although this mainly corresponds to designers and developers. They ensure that all systems and components function properly before delivering them to internal and external clients."@en ;

    skos:prefLabel "IT-Systemprüfer/IT-Systemprüferin"@de,

        "ICT system tester"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "52d5edc9-7902-4cd3-8b06-6bd77c98d440" .



<http://data.europa.eu/esco/occupation/57af9090-55b4-4911-b2d0-86db01c00b02> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Embedded systems software developers program, implement, document and maintain software to be run on an embedded system."@en ;

    skos:prefLabel "Softwareentwickler für Embedded Systems/Softwareentwicklerin für Embedded Systems"@de,

        "embedded systems software developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "57af9090-55b4-4911-b2d0-86db01c00b02" .



<http://data.europa.eu/esco/occupation/5f50290d-f520-4a69-85c7-1390d2a4a8b6> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT usability testers ensure compliance with requirements and strive for optimal usability within the software engineering cycle phases (analysis, design, implementation, and deployment). They also work closely with users (analysts) to research for and document user profiles, analyse tasks, workflows, and user scenarios."@en ;

    skos:prefLabel "IT-Usability-Engineer"@de,

        "ICT usability tester"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "5f50290d-f520-4a69-85c7-1390d2a4a8b6" .



<http://data.europa.eu/esco/occupation/6ce5f7e3-a534-4aa2-ab23-255408ddb53a> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "IoT developers analyse and gather data for interpreting the pattern and predicting the result. They use artificial intelligence for managing the tasks and autonomous decisions, employing machine learning algorithms to create smarter devices through data sensors. IoT developers create software for connecting objects to systems and devices, or for programming these objects to make them function on their own."@en ;

    skos:prefLabel "IoT-Entwickler/IoT-Entwicklerin"@de,

        "IoT developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "6ce5f7e3-a534-4aa2-ab23-255408ddb53a" .



<http://data.europa.eu/esco/occupation/6e5ceba0-df96-465f-adb4-2e06ae715d43> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Numerical tool and process control programmers develop computer programs to control automatic machines and equipment involved in manufacturing processes. They analyse blueprints and job orders, conduct computer simulations and trial runs."@en ;

    skos:prefLabel "CNC-Programmierer/CNC-Programmiererin"@de,

        "numerical tool and process control programmer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "6e5ceba0-df96-465f-adb4-2e06ae715d43" .



<http://data.europa.eu/esco/occupation/6e92d4b5-3167-4166-802f-da7753951a31> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT research consultants perform targeted ICT research and provide a final report to the client. They also use ICT tools to design questionnaires for surveys, analyse the results, write reports, present the results and make recommendations based on the research findings."@en ;

    skos:prefLabel "IT-Forschungsberater/IT-Forschungsberaterin"@de,

        "ICT research consultant"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "6e92d4b5-3167-4166-802f-da7753951a31" .



<http://data.europa.eu/esco/occupation/7086d0ca-1e77-4690-89c9-7ed1a0478fa3> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Data quality specialists review organisation's data for accuracy, recommend enhancements to record systems and data acquisition processes and assess referential and historical integrity of data. They also develop documents and maintain data quality goals and standards and oversee an organisation's data privacy policy and monitor compliance of data flows against data quality standards."@en ;

    skos:prefLabel "Datenqualitätsexperte/Datenqualitätsexpertin"@de,

        "data quality specialist"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "7086d0ca-1e77-4690-89c9-7ed1a0478fa3" .



<http://data.europa.eu/esco/occupation/731f38f1-b08f-4dd5-a25e-f8627c038273> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT integration testers perform tests in groups of system components, units or even applications. They group them in larger aggregates and apply integration test plans on them. They oversee the complexity of relations between different components."@en ;

    skos:prefLabel "IT-Integrationstester/IT-Integrationstesterin"@de,

        "ICT integration tester"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "731f38f1-b08f-4dd5-a25e-f8627c038273" .



<http://data.europa.eu/esco/occupation/76a1a76c-b014-4600-8901-56cb936de7ed> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT auditor managers monitor ICT auditors responsible for auditing information systems, platforms, and operating procedures in accordance with established corporate standards for efficiency, accuracy and security. They evaluate ICT infrastructure in terms of risk to the organisation and establish controls to mitigate loss. They determine and recommend improvements in the current risk management controls and in the implementation of system changes or upgrades."@en ;

    skos:prefLabel "IT-Audit-Manager/IT-Audit-Managerin"@de,

        "ICT auditor manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "76a1a76c-b014-4600-8901-56cb936de7ed" .



<http://data.europa.eu/esco/occupation/76ef0a87-6afe-4560-b5d0-9a086abe45c5> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Ethical hackers perform security vulnerability assessments and penetration tests in accordance with industry-accepted methods and protocols. They analyse systems for potential vulnerabilities that may result from improper system configuration, hardware or software flaws, or operational weaknesses."@en ;

    skos:prefLabel "ethischer Hacker/ethische Hackerin"@de,

        "ethical hacker"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "76ef0a87-6afe-4560-b5d0-9a086abe45c5" .



<http://data.europa.eu/esco/occupation/7754d570-9519-48c2-b1c9-8e165f8bca0f> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cybersecurity risk managers identify, analyse, assess, estimate and mitigate cybersecurity-related risks of ICT infrastructures such as systems or services. They manage these aspects by planning risk analysis, applying, reporting, assessing, communicating, and treating them. They establish a risk management strategy for the organisation and ensure that risks remain at an acceptable level for the organisation by selecting mitigation actions and controls."@en ;

    skos:prefLabel "Risikomanager für Cybersicherheit/Risikomanagerin für Cybersicherheit"@de,

        "cybersecurity risk manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "7754d570-9519-48c2-b1c9-8e165f8bca0f" .



<http://data.europa.eu/esco/occupation/781a6350-e686-45b9-b075-e4c8d5a05ff7> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cloud software developers create, deploy, and modernize software applications to run on the cloud using microservices, containers, and serverless technologies. They develop scalable and highly available applications using cloud architectures and best practices. They incorporate logging and monitoring into their code and are able to perform root cause analysis on failures."@en ;

    skos:prefLabel "Cloud-Softwareentwickler/Cloud-Softwareentwicklerin"@de,

        "cloud software developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "781a6350-e686-45b9-b075-e4c8d5a05ff7" .



<http://data.europa.eu/esco/occupation/78faf623-2543-43a5-acb2-3c43a22d36e4> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Blockchain architects are ICT system architects that are specialized in blockchain-based solutions. They design architecture, components, modules, interfaces, and data for a decentralized system to meet specified requirements."@en ;

    skos:prefLabel "Blockchain-Architekt/Blockchain-Architektin"@de,

        "blockchain architect"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "78faf623-2543-43a5-acb2-3c43a22d36e4" .



<http://data.europa.eu/esco/occupation/812c217d-32b7-4f6a-9faf-993d3577ac7f> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Knowledge engineers integrate structured knowledge into computer systems (knowledge bases) in order to solve complex problems normally requiring a high level of human expertise or artificial intelligence methods. They are also responsible for eliciting or extracting knowledge from information sources, maintaining this knowledge, and making it available to the organisation or users. To achieve this, they are aware of knowledge representation and maintenance techniques (rules, frames, semantic nets, ontologies) and use knowledge extraction techniques and tools. They can design and build expert or artificial intelligence systems that use this knowledge."@en ;

    skos:prefLabel "Wissensingenieur/Wissensingenieurin"@de,

        "knowledge engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "812c217d-32b7-4f6a-9faf-993d3577ac7f" .



<http://data.europa.eu/esco/occupation/81480b40-a318-47f3-9b2c-56b69ed67d95> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT network administrators maintain operation of a reliable, secure, and efficient data communications network, including LAN, WAN, intranet, and internet. They perform network address assignment, management and implementation of routing protocols such as ISIS, OSPF, BGP, routing table configurations and certain implementations of authentication. They perform maintenance and administration of servers (file servers, VPN gateways, intrusion detection systems), desktop computers, printers, routers, switches, firewalls, phones, IP communications, personal digital assistants, smartphones, software deployment, security updates and patches as well as a vast array of additional technologies inclusive of both hardware and software."@en ;

    skos:prefLabel "IT-Netzwerk-Administrator/IT-Netzwerk-Administratorin"@de,

        "ICT network administrator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "81480b40-a318-47f3-9b2c-56b69ed67d95" .



<http://data.europa.eu/esco/occupation/866c7813-2c03-47d7-9bdc-192cfbace57c> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "User interface developers implement, code, document and maintain the interface of a software system by using front-end development technologies."@en ;

    skos:prefLabel "Entwickler von Benutzeroberflächen/Entwicklerin von Benutzeroberflächen"@de,

        "user interface developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "866c7813-2c03-47d7-9bdc-192cfbace57c" .



<http://data.europa.eu/esco/occupation/8c57af09-719c-42b3-be40-6ed4946236cc> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Database administrators test, implement and administer computer databases. They use their expertise in database management systems to plan, coordinate and implement security measures to safeguard computer databases. They also use scripts and configuration files to tailor a database to users' needs."@en ;

    skos:prefLabel "Datenbankadministrator/Datenbankadministratorin"@de,

        "database administrator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "8c57af09-719c-42b3-be40-6ed4946236cc" .



<http://data.europa.eu/esco/occupation/8d9ec84d-cf2d-4179-87bc-335cda54a427> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Database designers specify the database's logical structure, processes, and information flows. They design data models and databases to serve data acquisition."@en ;

    skos:prefLabel "Datenbankdesigner/Datenbankdesignerin"@de,

        "database designer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "8d9ec84d-cf2d-4179-87bc-335cda54a427" .



<http://data.europa.eu/esco/occupation/96e20037-0a25-4bf6-a25e-808d1605d890> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "User interface designers are in charge of designing user interfaces for applications and systems. They perform layout, graphics and dialogues design activities as well as adaptation activities."@en ;

    skos:prefLabel "Multimedia-Designer/Multimedia-Designerin"@de,

        "user interface designer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "96e20037-0a25-4bf6-a25e-808d1605d890" .



<http://data.europa.eu/esco/occupation/98c3d8f8-e3a8-49b7-9e58-236f25a6f6a0> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "System configurators tailor a computer system to the organisation's and users' needs. They adjust the base system and software to the needs of the customer. They perform configuration activities and scripting and ensure communication with users."@en ;

    skos:prefLabel "Systemkonfigurator/Systemkonfiguratorin"@de,

        "system configurator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "98c3d8f8-e3a8-49b7-9e58-236f25a6f6a0" .



<http://data.europa.eu/esco/occupation/9e2e6e1e-363b-4e1b-a673-7bc0f7343300> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT system administrators are responsible for the upkeep, configuration, and reliable operation of computer and network systems, servers, workstations and peripheral devices. They may acquire, install, or upgrade computer components and software; automate routine tasks; write computer programs; troubleshoot; train and supervise staff; and provide technical support. They ensure optimum system integrity, security, backup and performance."@en ;

    skos:prefLabel "IT-Systemadministrator/IT-Systemadministratorin"@de,

        "ICT system administrator"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "9e2e6e1e-363b-4e1b-a673-7bc0f7343300" .



<http://data.europa.eu/esco/occupation/9ebaf3f0-0be0-47b7-b2b1-b3b04130fa81> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Digital games developers program, implement and document digital games. They implement technical standards in gameplay, graphics, sound and functionality."@en ;

    skos:prefLabel "Game-Programmierer/Game-Programmiererin"@de,

        "digital games developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "9ebaf3f0-0be0-47b7-b2b1-b3b04130fa81" .



<http://data.europa.eu/esco/occupation/a28dff76-74df-46ee-929f-d1fffbb63cd7> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT quality assurance managers establish and operate an ICT quality approach through quality management systems, in compliance with internal and external standards and the organisation's culture. They ensure that the management controls are correctly implemented to safeguard asset, data integrity and operations. They focus on the achievement of quality goals, including the maintenance of the external certification according to quality standards and monitor statistics to forecast quality outcomes."@en ;

    skos:prefLabel "IT-Qualitätssicherungsmanager/IT-Qualitätssicherungsmanagerin"@de,

        "ICT quality assurance manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "a28dff76-74df-46ee-929f-d1fffbb63cd7" .



<http://data.europa.eu/esco/occupation/a6a0b60f-08da-4faa-bf54-942987efb471> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT system analysts specify the system needs to meet the end user requirements. They analyse system functions in order to define their goals or purposes and to discover operations and procedures for accomplishing them most efficiently. They also design new IT solutions to improve business efficiency and productivity, produce outline designs and estimate costs of new systems, specify the operations the system will perform, and the way data will be viewed by the end user. They present the design to the users and work closely with the users to implement the solution."@en ;

    skos:prefLabel "IT-Systemanalytiker/IT-Systemanalytikerin"@de,

        "ICT system analyst"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "a6a0b60f-08da-4faa-bf54-942987efb471" .



<http://data.europa.eu/esco/occupation/a74f6c51-37e5-423e-aa5b-044e98663027> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Web content managers curate or create content for a web platform according to the long-term strategic goals, policies and procedures for an organisation's online content or their customers. They control and monitor compliance with standards, legal and privacy regulations and ensure web optimisation. They are also responsible for integrating the work of writers and designers to produce a final layout which is compatible with corporate standards."@en ;

    skos:prefLabel "Web-Content-Manager/Web-Content-Managerin"@de,

        "web content manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "a74f6c51-37e5-423e-aa5b-044e98663027" .



<http://data.europa.eu/esco/occupation/a7c1d23d-aeca-4bee-9a08-5993ed98b135> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT system developers maintain, audit and improve organisational support systems. They use existing or new technologies to meet particular needs. They test both hardware and software system components, diagnose and resolve system faults."@en ;

    skos:prefLabel "IT-Systementwickler/IT-Systementwicklerin"@de,

        "ICT system developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "a7c1d23d-aeca-4bee-9a08-5993ed98b135" .



<http://data.europa.eu/esco/occupation/a99b38bc-6e71-4bef-b127-0f2b5e357815> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT resilience managers research, plan and develop models, policies, methods, techniques and tools that enhance an organisation's cyber security, resilience and disaster recovery."@en ;

    skos:prefLabel "IT-Notfallmanager/IT-Notfallmanagerin"@de,

        "ICT resilience manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "a99b38bc-6e71-4bef-b127-0f2b5e357815" .



<http://data.europa.eu/esco/occupation/b11e1742-5e28-4270-b081-b0193d85ee7d> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Database developers program, implement and coordinate changes to computer databases based on their expertise of database management systems."@en ;

    skos:prefLabel "Datenbankentwickler/Datenbankentwicklerin"@de,

        "database developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "b11e1742-5e28-4270-b081-b0193d85ee7d" .



<http://data.europa.eu/esco/occupation/b1c80369-067e-4041-84c8-dbe65640a5d8> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT consultants provide advice on how to optimise the use of existing tools and systems, make recommendations for the development and implementation of a business project or technological solution and contribute to project definitions. They raise awareness on information technology innovations and their potential value to a business. They also participate in the assessment and choice of ICT solutions."@en ;

    skos:prefLabel "IKT-Berater/IKT-Beraterin"@de,

        "ICT consultant"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "b1c80369-067e-4041-84c8-dbe65640a5d8" .



<http://data.europa.eu/esco/occupation/bb6198c4-1d3e-40b9-9cc4-ad2dd9d7c74b> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Industrial mobile devices software developers implement applications software for specific, professional industrial mobile (handheld) devices, based on the industry needs, using general or specific development tools for device operating systems."@en ;

    skos:prefLabel "Softwareentwickler Industrielle Mobilgeräte/Softwareentwicklerin Industrielle Mobilgeräte"@de,

        "industrial mobile devices software developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "bb6198c4-1d3e-40b9-9cc4-ad2dd9d7c74b" .



<http://data.europa.eu/esco/occupation/bd272aee-adc9-4a06-a15c-a73b4b4a46a7> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT application developers implement the ICT (software) applications based on the designs provided using application domain specific languages, tools, platforms and experience."@en ;

    skos:prefLabel "IT-Anwendungsentwickler/IT-Anwendungsentwicklerin"@de,

        "ICT application developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "bd272aee-adc9-4a06-a15c-a73b4b4a46a7" .



<http://data.europa.eu/esco/occupation/bd9d395a-d587-45c6-8d72-ceef226df9e1> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT system integration consultants advise on bringing together different systems to interoperate within an organisation for enabling data sharing and reducing redundancy."@en ;

    skos:prefLabel "IT-Consultant für Systemintegration"@de,

        "ICT system integration consultant"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "bd9d395a-d587-45c6-8d72-ceef226df9e1" .



<http://data.europa.eu/esco/occupation/c40a2919-48a9-40ea-b506-1f34f693496d> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Web developers develop, implement and document web-accessible software based on the designs provided. They align the client's web presence with its business strategy, troubleshoot software problems and issues and look for ways to improve the application."@en ;

    skos:prefLabel "Web-Designer/Web-Designerin"@de,

        "web developer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "c40a2919-48a9-40ea-b506-1f34f693496d" .



<http://data.europa.eu/esco/occupation/cc325a8f-702e-4bf0-893f-5b5d456475ad> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cloud identity managers work with identity access management's applications. Collaborate with senior management to address key risks in the identity governance. Plan strategies to comply with professional standards."@en ;

    skos:prefLabel "Cloud Identity and Access Manager/Cloud Identity and Access Managerin"@de,

        "cloud identity manager"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "cc325a8f-702e-4bf0-893f-5b5d456475ad" .



<http://data.europa.eu/esco/occupation/cc867bee-ab5c-427f-9244-f7a204d9574b> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Cloud DevOps engineers implement and manage continuous software delivery systems and methodologies. This includes managing and configuring code repositories, build services, automated testing, and deployment mechanisms. For cloud-based workloads, a Cloud DevOps Engineer define and deploy infrastructure as code, automating test and development environments. They can define and configure automated disaster recovery solutions that meet business objectives."@en ;

    skos:prefLabel "Cloud-DevOps-Ingenieur/Cloud-DevOps-Ingenieurin"@de,

        "cloud DevOps engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "cc867bee-ab5c-427f-9244-f7a204d9574b" .



<http://data.europa.eu/esco/occupation/cdd3d773-75a4-4f35-bd1d-1ac720afcf9d> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "IT auditors perform audits of information systems, platforms, and operating procedures in accordance with established corporate standards for efficiency, accuracy and security. They evaluate ICT infrastructure in terms of risk to the organisation and establish controls to mitigate loss. They determine and recommend improvements in the current risk management controls and in the implementation of system changes or upgrades."@en ;

    skos:prefLabel "IT-Prüfer/IT-Prüferin"@de,

        "IT auditor"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "cdd3d773-75a4-4f35-bd1d-1ac720afcf9d" .



<http://data.europa.eu/esco/occupation/cf2b03cd-feb7-4f47-90f6-ff1ed6016d3d> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "ICT network engineers implement, maintain and support computer networks. They also perform network modelling, analysis, and planning. They may also design network and computer security measures. They may research and recommend network and data communications hardware and software."@en ;

    skos:prefLabel "IT-Netzwerkingenieur/IT-Netzwerkingenieurin"@de,

        "ICT network engineer"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "cf2b03cd-feb7-4f47-90f6-ff1ed6016d3d" .



<http://data.europa.eu/esco/occupation/d0aa0792-4345-474b-9365-686cf4869d2e> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Software architects create the technical design and the functional model of a software system, based on functional specifications. They also design the architecture of the system or different modules and components related to the business' or customer requirements, technical platform, computer language or development environment."@en ;

    skos:prefLabel "Softwarearchitekt/Softwarearchitektin"@de,

        "software architect"@en ;

    hrqde:derivedFrom "esco" ;

    hrqde:sourceIdentifier "d0aa0792-4345-474b-9365-686cf4869d2e" .



<http://data.europa.eu/esco/occupation/d3edb8f8-3a06-47a0-8fb9-9b212c006aa2> a skos:Concept ;
    a harm:CompetenceConcept ;

    dcterms:source "ESCO v1.2" ;

    skos:definition "Data analysts import, inspect, clean, transform, validate, model, or interpret collections of data with regard to the business goals of the company. They ensure that the data sources and repositories provide consistent and reliable data. Data analysts use different algorithms and IT tools as demanded by the situation and the current data. They might prepare reports in the form of visualisations such as graphs, charts, and dashboards."@en ;

