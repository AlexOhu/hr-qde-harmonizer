    skos:prefLabel "E.7 – Management von Geschäftsprozessveränderungen, Proficiency 5"@de, "E.7 – Business Change Management, Proficiency 5"@en ;
    skos:definition "Nutzt den eigenen, tiefgehenden Einfluss, um Veränderungen in der Organisation zu verankern."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
