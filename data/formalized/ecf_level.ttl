harm-ecf:E.8 a skos:Concept ;
    owl:sameAs ecf:E.8 ;
    skos:prefLabel "Information Security Management"@en, "ITK-Sicherheitsmanagement"@de ;
    skos:definition "Implements information security strategies. Monitors and counters intrusion, fraud and security breaches or vulnerabilities. Ensures that security risks regarding company data and information are analyzed and managed. Reviews information security incidents, makes recommendations for security policies and strategy to achieve continuous improvement of security measures."@en ;
    dcterms:source "e-CF 3.0" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.8" ;
    a harm:CompetenceConcept ;
    harm:hasLevel harm-ecf:E.8.Niveau2, harm-ecf:E.8.Niveau3, harm-ecf:E.8.Niveau4 ;
    skos:broader ecf:manage .

harm-ecf:E.8.Niveau2 a skos:Concept ;
    skos:prefLabel "E.8 – ITK-Sicherheitsmanagement, Proficiency 2"@de, "E.8 – Information Security Management, Proficiency 2"@en ;
    skos:definition "Sucht das Umfeld systematisch ab, um Schwachstellen und Bedrohungen zu identifizieren und zu definieren. Hält Nichteinhaltung von Sicherheitsbestimmungen fest und gibt sie weiter."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.8 Niveau 2" ;
    a harm:LevelConcept ;
    harm:eqfCrosswalkTarget dqr:L5 .

harm-ecf:E.8.Niveau3 a skos:Concept ;
    skos:prefLabel "E.8 – ITK-Sicherheitsmanagement, Proficiency 3"@de, "E.8 – Information Security Management, Proficiency 3"@en ;
    skos:definition "Evaluiert Maßnahmen und Indikatoren zum Sicherheitsmanagement und entscheidet, ob sie konform mit der Informationssicherheitspolitik sind. Untersucht und initiiert Maßnahmen zur Abhilfe im Fall von Sicherheitsverletzungen."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.8 Niveau 3" ;
    a harm:LevelConcept ;
    harm:eqfCrosswalkTarget dqr:L6 .

harm-ecf:E.8.Niveau4 a skos:Concept ;
    skos:prefLabel "E.8 – ITK-Sicherheitsmanagement, Proficiency 4"@de, "E.8 – Information Security Management, Proficiency 4"@en ;
    skos:definition "Ist leitend verantwortlich für die Integrität, Sicherheit und Verfügbarkeit der in Informationssystemen gespeicherten Daten."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.8 Niveau 4" ;
    a harm:LevelConcept ;
    harm:eqfCrosswalkTarget dqr:L7 .

harm-ecf:E.9 a skos:Concept ;
    owl:sameAs ecf:E.9 ;
    skos:prefLabel "IS Governance"@en, "ITK-Gouvernance"@de ;
    skos:definition "Determines the use of information systems in the company as a whole in line with business requirements and controls it accordingly. Considers all internal and external aspects, such as compliance with legal requirements and industry standards, to achieve a balanced ratio between risk management and resource use on the one hand and business profit on the other."@en ;
    dcterms:source "e-CF 3.0" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.9" ;
    a harm:CompetenceConcept ;
    harm:hasLevel harm-ecf:E.9.Niveau4, harm-ecf:E.9.Niveau5 ;
    skos:broader ecf:manage .

harm-ecf:E.9.Niveau4 a skos:Concept ;
    skos:prefLabel "E.9 – ITK-Gouvernance, Proficiency 4"@de, "E.9 – IS Governance, Proficiency 4"@en ;
    skos:definition "Ist verantwortlich für die Umsetzung der ITK-Governance-Strategie in die gesamte ITK-Infrastruktur und setzt dies durch Kommunikation sowie Verbreitung und Kontrolle einschlägiger Prozesse durch."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.9 Niveau 4" ;
    a harm:LevelConcept ;
    harm:eqfCrosswalkTarget dqr:L7 .

harm-ecf:E.9.Niveau5 a skos:Concept ;
    skos:prefLabel "E.9 – ITK-Gouvernance, Proficiency 5"@de, "E.9 – IS Governance, Proficiency 5"@en ;
    skos:definition "Legt die ITK-Governance-Strategie fest und sorgt dafür, dass sie in die Corporate-Governance-Strategie der Gesamtorganisation einfließt. Passt die ITK-Governance-Strategie so an, dass alle neuen wichtigen Einflüsse beachtet werden, die aus gesetzlichen, wirtschaftlichen, politischen, geschäftlichen, technischen oder ökologischen Anforderungen hervorgehen."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.9 Niveau 5" ;
    a harm:LevelConcept ;
    harm:eqfCrosswalkTarget dqr:L8 .
