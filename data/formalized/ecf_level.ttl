    skos:prefLabel "E.7 – Management von Geschäftsprozessveränderungen, Proficiency 4"@de, "E.7 – Business Change Management, Proficiency 4"@en ;
    skos:definition "Leitet die Planung, Steuerung und Durchführung bedeutender ITK-bedingter Geschäftsveränderungen."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
