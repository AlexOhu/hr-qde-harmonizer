harm-ecf:E.7.Niveau3 a skos:Concept ;
    skos:prefLabel "E.7 – Management von Geschäftsprozessveränderungen, Proficiency 3"@de, "E.7 – Business Change Management, Proficiency 3"@en ;
    skos:definition "Evaluiert Veränderungsbedarfe und nutzt fachliche Fertigkeiten, um mögliche geeignete Methoden und Standards zu identifizieren."@de ;
    dcterms:source "e-CF 3.0, Dimension 3 (CWA 16234-1:2014)" ;
    harm:derivedFrom harm:kqr_ecf ;
    harm:sourceIdentifier "E.7 Niveau 3" ;
    a harm:LevelConcept ;
