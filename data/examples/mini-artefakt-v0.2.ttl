# ==============================================================================
# Mini-Artefakt: Ausschnitt der harmonisierten HR-QDE-Ontologie
# Datum: 2026-08-06
# Version: v0.2
# Pipeline-Version: HR-QDE-Harmonizer v0.1
# Verglichene Rahmen: ESCO v1.2 (ICT-Ausschnitt), e-CF 3.0, EQF 2017, DQR 2013
#
# SSSOM-Header (übernommen aus _SSSOM_HEADER,
# app/pipeline/step4_export/sssom_writer.py):
# mapping_set_version: "0.15"
# mapping_tool: HR-QDE-Harmonizer-v0.2
# curie_map:
#   semapv: "https://w3id.org/semapv/vocab/"
#   skos: "http://www.w3.org/2004/02/skos/core#"
#   hrqde: "http://hr-qde.org/harmonised/"
# ==============================================================================

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hrqde:   <http://hr-qde.org/harmonised/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix sssom:   <https://w3id.org/sssom/> .

# Quell-KQR-Präfixe, Basis-URIs identisch zu data/formalized/*.ttl
@prefix ecf:       <http://hr-qde.org/harmonised/ecf/> .
@prefix escoskill: <http://data.europa.eu/esco/skill/> .
@prefix eqf:       <http://data.europa.eu/snb/eqf/> .
@prefix dqr:       <http://data.bmbf.de/dqr/> .

# ==============================================================================
# Szenario 1 -- Konjunktes Konzeptpaar aus K, mapping_justification =
# semapv:LLMBasedMatching
# e-CF B.1 "Application Development" (gröber) <-> ESCO-Skill "develop
# software prototype" (feiner granuliert), ermittelt per LLM-Dreifach-
# klassifikation mit Mehrheitsentscheid A_SUBSUMES_B.
# ==============================================================================

ecf:B.1 a skos:Concept ;
    skos:prefLabel "Application Development"@en, "Anwendungsentwicklung"@de ;
    dcterms:source "e-CF 3.0" ;
    hrqde:derivedFrom "ecf" ;
    hrqde:sourceIdentifier "B.1" .

escoskill:797a4416-0b8d-44f3-8fcd-eb10bd0be6b4 a skos:Concept ;
    skos:prefLabel "develop software prototype"@en,
        "Softwareprototyp entwickeln"@de ;
    dcterms:source "ESCO v1.2" ;
    hrqde:derivedFrom "esco" ;
    hrqde:sourceIdentifier "797a4416-0b8d-44f3-8fcd-eb10bd0be6b4" .

ecf:B.1 skos:broadMatch escoskill:797a4416-0b8d-44f3-8fcd-eb10bd0be6b4 .

hrqde:mapping_1 a sssom:MappingSet ;
    sssom:subject_id ecf:B.1 ;
    sssom:object_id escoskill:797a4416-0b8d-44f3-8fcd-eb10bd0be6b4 ;
    sssom:predicate_id "skos:broadMatch" ;
    sssom:mapping_confidence 0.89 ;
    sssom:mapping_tool "HR-QDE-Harmonizer-v0.1" ;
    sssom:mapping_justification semapv:LLMBasedMatching ;
    sssom:comment "Dreifachklassifikation (Majority-Vote): e-CF B.1 subsumiert den feiner granulierten ESCO-Skill 'develop software prototype'."@de .

hrqde:HarmonisedCluster_SoftwareEngineering a owl:Class ;
    rdfs:label "Software Engineering (harmonisiert)"@de,
        "Software Engineering (harmonised)"@en ;
    rdfs:comment "Konjunkte Schnittmenge aus e-CF B.1 und verwandten ESCO-ICT-Skills." ;
    hrqde:harmonises ecf:B.1, escoskill:797a4416-0b8d-44f3-8fcd-eb10bd0be6b4 .

# ==============================================================================
# Szenario 2 -- Konjunktes Konzeptpaar mit strukturellem Shortcut,
# mapping_justification = semapv:StructuralMatching
# DQR "Wissen – Niveau 5" <-> EQF "Knowledge – EQF Level 5". Die Cross-
# Referenz auf Dimensionsebene ist normativ aus dem German EQF Referencing
# Report (2012/2013) abgeleitet (vgl. eval/G_struct.json, 32 DQR<->EQF-
# Dimensionspaare) und wird vom Vorfilter als Shortcut ohne LLM-
# Klassifikation übernommen.
# ==============================================================================

dqr:L5_Knowledge a skos:Concept ;
    skos:prefLabel "Wissen – Niveau 5"@de, "Knowledge – Level 5"@en ;
    dcterms:source "Deutscher Qualifikationsrahmen 2013" ;
    hrqde:derivedFrom "dqr" ;
    hrqde:sourceIdentifier "L5_Knowledge" .

eqf:L5_Knowledge a skos:Concept ;
    skos:prefLabel "Knowledge – EQF Level 5"@en ;
    dcterms:source "OJ C 189, 15.6.2017, Annex II" ;
    hrqde:derivedFrom "eqf" ;
    hrqde:sourceIdentifier "L5_Knowledge" .

dqr:L5_Knowledge skos:exactMatch eqf:L5_Knowledge .

hrqde:mapping_2 a sssom:MappingSet ;
    sssom:subject_id dqr:L5_Knowledge ;
    sssom:object_id eqf:L5_Knowledge ;
    sssom:predicate_id "skos:exactMatch" ;
    sssom:mapping_confidence 1.0 ;
    sssom:mapping_tool "HR-QDE-Harmonizer-v0.1" ;
    sssom:mapping_justification semapv:StructuralMatching ;
    sssom:comment "Struktureller Shortcut: Dimensionspaar 'Wissen'/'Knowledge' auf Niveau 5, normativ aus dem German EQF Referencing Report (2012/2013), vgl. G_struct.json."@de .

# ==============================================================================
# Szenario 3 -- Disjunktes Konzept (D), Integrationsstrategie standalone_class
# DQR-Dimension "Sozialkompetenz - Niveau 6" hat kein direktes ESCO-Pendant,
# da ESCO Sozialkompetenzen nicht als eigenständige, niveaugestufte
# Kompetenzdimension modelliert.
# ==============================================================================

dqr:L6_SocialCompetence a hrqde:HarmonisedConcept ;
    skos:prefLabel "Social Skills – Level 6"@en, "Sozialkompetenz – Niveau 6"@de ;
    dcterms:source "Deutscher Qualifikationsrahmen 2013" ;
    hrqde:derivedFrom "dqr" ;
    hrqde:sourceIdentifier "L6_SocialCompetence" ;
    hrqde:integrationStrategy "standalone_class" ;
    rdfs:comment "Kein korrespondierendes ESCO-Konzept im ICT-Ausschnitt vorhanden: ESCO modelliert Sozialkompetenz nicht als eigenständige, niveaugestufte Kompetenzdimension wie der DQR. Das Konzept wird daher als eigenständige hrqde:HarmonisedConcept-Klasse ohne Anbindung an einen bestehenden Hub-Knoten übernommen."@de .