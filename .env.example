# LLM-Provider für Schritt 3 (Klassifikation), vgl. ADR-7 und VH1.6
#
# Kommagetrennte Liste — Reihenfolge bestimmt Round-Robin-Verteilung der Läufe:
#   "anthropic"                  → alle drei Läufe über Anthropic Claude
#   "mistral"                    → alle drei Läufe über Mistral
#   "anthropic,openai,gemini"    → je ein Lauf pro Anbieter
#   "mistral,openai"             → alternierend (Lauf 1=mistral, 2=openai, 3=mistral)
#
# Nur die API-Keys der tatsächlich konfigurierten Anbieter müssen gesetzt sein.
LLM_PROVIDERS=mistral

# Anthropic Claude (aktiv wenn "anthropic" in LLM_PROVIDERS)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI ChatGPT (aktiv wenn "openai" in LLM_PROVIDERS)
# Paket-Voraussetzung: pip install openai>=1.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (aktiv wenn "gemini" in LLM_PROVIDERS)
# Paket-Voraussetzung: pip install google-generativeai>=0.8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI (aktiv wenn "mistral" in LLM_PROVIDERS)
# Paket-Voraussetzung: pip install mistralai>=1.0
# EU-Rechenzentren, DSGVO-konform — empfohlen für den europäischen IKT-Kontext
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Gilt für alle Provider (0 = maximale Reproduzierbarkeit, vgl. VH1.6)
CLASSIFICATION_TEMPERATURE=0
CLASSIFICATION_RUNS_PER_PAIR=3

# Neo4j (Graph-Store, vgl. ADR-3)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# Embedding-Modell (Schritt 2) — begründet gewählt gemäß VH1.4
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# ANN-Suche (Schritt 2) — initiales k, endgültige Validierung in Kapitel 5 (VH1.5)
ANN_TOP_K=20

# Confidence-Schwelle für automatische Übernahme (VH1.7)
# empirisch bestimmt, E3 (Kapitel 5, Tab. tab:exp3_confidence): theta_op = 0.67
MAPPING_CONFIDENCE_THRESHOLD=0.67

# --- React-Frontend (frontend/) ---
# Browser-Origins, die auf die API zugreifen duerfen (kommagetrennt).
# Der Vite-Dev-Server laeuft standardmaessig auf Port 5173.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
